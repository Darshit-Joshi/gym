# ==============================================================================
# OneCountry Fitness: configuration
#
# Docker deployment:  cp .env.example .env, fill in the REQUIRED values, then
#                     docker compose up -d --build
# Local development:  the backend also reads DATABASE_URL etc. from this file
#                     (see the "Local development only" section at the bottom).
# ==============================================================================

# ---- REQUIRED --------------------------------------------------------------
# Database password (used to create the database on first start; keep it safe)
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Signs login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=generate_and_replace_with_a_64_char_hex_secret_key_in_production

# ---- Recommended -----------------------------------------------------------
# Port the app is served on (put HTTPS in front of it)
APP_PORT=8080

# After creating your trainer account, set this to false so nobody else can sign up
ALLOW_TRAINER_REGISTRATION=true

# Lets an administrator reset the trainer password through the API (optional)
ADMIN_RECOVERY_KEY=

# Gym timezone: decides what "today" is for attendance, dues and month boundaries
TIMEZONE=Asia/Kolkata

# Currency for fees, and the country code added to 10-digit phone numbers for WhatsApp links
DEFAULT_CURRENCY=INR
DEFAULT_PHONE_COUNTRY_CODE=91

# ---- Optional --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=gym_db
# Host port for reaching the database from this machine only (backups, local tools)
DB_HOST_PORT=5433
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Background job that creates monthly dues and raises absence/fee alerts
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
# API worker processes
WEB_CONCURRENCY=2
# Where photos are stored: "local" (a Docker volume, fine on a VPS) or "s3" for an
# S3-compatible bucket (Cloudflare R2, AWS S3), required on hosts that wipe the disk (Render)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed if another website calls the API directly (comma-separated origins)
CORS_ORIGINS=

# ---- Local development only (ignored by docker compose) ----------------------
# Used when running the backend directly with uvicorn against the db container.
ENVIRONMENT=development
DATABASE_URL=postgresql+pg8000://postgres:change_me_to_a_long_random_password@localhost:5433/gym_db
PORT=8000
